<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.sys.RoleMenuMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.entity.sys.RoleMenu">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="menu_id" property="menuId"/>
        <result column="role_name" property="roleName"/>
        <result column="menu_name" property="menuName"/>
    </resultMap>

    <sql id="Base_Column_List">
        rm.id, rm.role_id, rm.menu_id, r.role_name, m.title AS menu_name
    </sql>

    <!-- 列表查询条件（分页列表与 count 共享，保证口径一致） -->
    <sql id="List_Where">
        <where>
            <if test="roleId != null">
                AND rm.role_id = #{roleId}
            </if>
            <if test="menuId != null">
                AND rm.menu_id = #{menuId}
            </if>
        </where>
    </sql>

    <select id="selectList" parameterType="com.example.demo.entity.sys.RoleMenu" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_role_menu rm
        LEFT JOIN t_role r ON r.role_id = rm.role_id
        LEFT JOIN t_menu m ON m.menu_id = rm.menu_id
        <include refid="List_Where"/>
        ORDER BY rm.id ASC
    </select>

    <select id="selectPage" parameterType="com.example.demo.entity.sys.RoleMenu" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_role_menu rm
        LEFT JOIN t_role r ON r.role_id = rm.role_id
        LEFT JOIN t_menu m ON m.menu_id = rm.menu_id
        <include refid="List_Where"/>
        ORDER BY rm.id ASC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="count" parameterType="com.example.demo.entity.sys.RoleMenu" resultType="long">
        SELECT COUNT(*)
        FROM t_role_menu rm
        <include refid="List_Where"/>
    </select>

    <insert id="insert" parameterType="com.example.demo.entity.sys.RoleMenu"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_role_menu (role_id, menu_id)
        VALUES (#{roleId}, #{menuId})
    </insert>

    <delete id="deleteById" parameterType="long">
        DELETE FROM t_role_menu WHERE id = #{id}
    </delete>

    <delete id="deleteByRoleId" parameterType="long">
        DELETE FROM t_role_menu WHERE role_id = #{roleId}
    </delete>

    <select id="selectMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id FROM t_role_menu WHERE role_id = #{roleId}
    </select>

</mapper>
