<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.sys.UserMapper">

    <resultMap id="BaseResultMap" type="com.example.demo.entity.sys.User">
        <id column="user_id" property="userId"/>
        <result column="username" property="userName"/>
        <result column="password" property="password"/>
        <result column="salt" property="salt"/>
        <result column="nickname" property="nickname"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="age" property="age"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="province" property="province"/>
        <result column="city" property="city"/>
        <result column="district" property="district"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id, username, password, salt, nickname, email, phone, age, name, status,
        province, city, district, create_time, update_time
    </sql>

    <!-- 列表查询条件（分页列表与 count 共享，保证口径一致） -->
    <sql id="List_Where">
        <where>
            <if test="userName != null and userName != ''">
                AND username LIKE CONCAT('%', #{userName}, '%')
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <!-- 数据权限：省/市/区过滤（由 DataPermission 切面注入） -->
            <if test="province != null and province != ''">
                AND province = #{province}
            </if>
            <if test="city != null and city != ''">
                AND city = #{city}
            </if>
            <if test="district != null and district != ''">
                AND district = #{district}
            </if>
        </where>
    </sql>

    <select id="queryUserPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_user
        <include refid="List_Where"/>
        ORDER BY user_id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countUser" resultType="long">
        SELECT COUNT(*)
        FROM t_user
        <include refid="List_Where"/>
    </select>

    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_user
        WHERE username = #{userName}
    </select>

    <insert id="addUser" parameterType="com.example.demo.entity.sys.User"
            useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO t_user (username, password, salt, nickname, email, phone, age, name, status, province, city, district)
        VALUES (#{userName}, #{password}, #{salt}, #{nickname}, #{email}, #{phone}, #{age}, #{name}, #{status},
                #{province}, #{city}, #{district})
    </insert>

    <update id="updatePasswordByUsername" parameterType="com.example.demo.entity.sys.User">
        UPDATE t_user
        SET password = #{password}
        WHERE username = #{userName}
    </update>

    <update id="updateUser" parameterType="com.example.demo.entity.sys.User">
        UPDATE t_user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="age != null">age = #{age},</if>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="district != null">district = #{district},</if>
        </set>
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM t_user WHERE user_id = #{userId}
    </delete>

</mapper>
